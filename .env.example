# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NODE_ENV: Application environment mode ('development' | 'production' | 'test')
NODE_ENV="development"

# PORT: Server listener port (default 3000)
PORT="3000"

# CIPHER_DB_PATH: Path for single-instance durable database file (default: server/cipher_db.json)
CIPHER_DB_PATH=""

# CIPHER_SQLITE_PATH: Path for single-instance SQLite database file (default: cipher.sqlite, e.g. /data/cipher.sqlite on persistent mount)
CIPHER_SQLITE_PATH=""

# CIPHER_BACKUP_PATH: Directory for local database recovery backups (default: server/backups)
CIPHER_BACKUP_PATH=""

# ALLOWED_ORIGINS: Comma-separated list of permitted browser origins for production CORS
ALLOWED_ORIGINS=""

# Cloud SQL PostgreSQL connection variables (automatically provisioned & injected by platform)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
